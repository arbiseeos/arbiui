  "scripts": {
    "typecheck": "turbo run typecheck",
    "build": "turbo run clean:output build",
    "clean": "turbo run clean:output clean:modules && rm -rf node_modules && bash -O globstar -c 'rm -rf **/.turbo'",
    "clean:output": "turbo run clean:output",
    "clean:modules": "turbo run clean:modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "prettier": "^3.9.9",
    "turbo": "^2.11.5",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "pnpm@12.8.1"
}
